{
  "name": "chain-reaction-global",
  "version": "0.1.0",
  "private": true,
  "description": "Glow-styled Chain Reaction game built with Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:rooms": "wrangler dev --port 1999",
    "deploy:rooms": "wrangler deploy"
  },
  "overrides": {
    "postcss": "^8.5.26"
  },
  "dependencies": {
    "motion": "^12.38.0",
    "next": "^15.5.23",
    "partysocket": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
